{
  "name": "coinscanner",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pwa",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "icons": "node scripts/generate-icons.mjs",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "sw": "node scripts/generate-sw.mjs",
    "build:pwa": "npm run icons && npm run vendor:ocr && vite build && npm run sw -- dist",
    "check": "npm run typecheck && npm run build:pwa"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.33.5",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
